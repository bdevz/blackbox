# Required — powers all AI agents
ANTHROPIC_API_KEY=
# Claude model for all agents (default: claude-opus-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Optional — enables similar proposal search via Voyage embeddings (legacy pgvector)
VOYAGE_API_KEY=

# OpenAI — powers embeddings for Pinecone RAG (text-embedding-3-small)
OPENAI_API_KEY=

# Pinecone — vector store for indexed RAG across proposals, RFPs, company knowledge
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rfp-blackbox
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional — enables automated RFP sourcing from HigherGov
HIGHERGOV_API_KEY=

# Optional — enables HubSpot deal outcome sync
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=243046792

# Optional — enables Slack channel reading (awards, submissions)
SLACK_BOT_TOKEN=
SLACK_INTERVIEW_CHANNEL=C088YP1M732
SLACK_GENERAL_CHANNEL=C07AYH29X4L

# Optional — enables Coda RFP data extraction
CODA_API_TOKEN=
CODA_DOC_ID=dSt8mkiTmO7

# Optional — S3 for document storage
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Auto-configured by Docker Compose — only set for local dev
DATABASE_URL=postgresql://blackbox:blackbox@localhost:5432/blackbox
REDIS_URL=redis://localhost:6379/0
